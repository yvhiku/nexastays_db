# Nexa database backup / restore configuration (copy to a private env file; never commit secrets).
# Typical (Linux VPS): /etc/nexa/backup.env (chmod 600), loaded by systemd via run-scheduled-backup.sh
# Typical (Windows/local):
#   Get-Content .env.backup | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "env:$($Matches[1])" $Matches[2] } }

# Stage — production forces remote/off-site copy
# development|dogfood|staging|production
NEXA_ENV=development

# Required for backup
BACKUP_DIR=/var/backups/nexa
BACKUP_RETENTION_DAYS=30
BACKUP_LOCK_FILE=/var/lock/nexa-db-backup.lock

# Source databases (logical dumps). Use secrets/CI vars in real environments.
# VPS compose publishes PG on localhost:
IDENTITY_DATABASE_URL=postgresql://nexa_identity:CHANGE_ME@127.0.0.1:5433/nexa_identity
STAYS_DATABASE_URL=postgresql://nexa_stays:CHANGE_ME@127.0.0.1:5434/nexa_stays

# Optional: force dockerized pg clients (auto-detected if pg_dump missing)
# BACKUP_PG_IMAGE=postgres:16-alpine

# Off-host / remote copy
# When NEXA_ENV=production (or BACKUP_REQUIRE_REMOTE=true): remote is MANDATORY.
BACKUP_REQUIRE_REMOTE=false
BACKUP_REMOTE_ENABLED=false
# filesystem | s3
BACKUP_REMOTE_PROVIDER=s3
# filesystem destination OR s3 object key prefix
BACKUP_REMOTE_PATH=production/

# S3-compatible (AWS S3, MinIO, R2) — production requires https endpoint when set
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=nexa-db-backups
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Restore safety (never set casually)
# RESTORE_CONFIRM=YES
# RESTORE_ALLOW_PRODUCTION=YES
