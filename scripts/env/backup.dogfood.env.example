# Dogfood backup policy template — copy to /etc/nexa/backup.env (chmod 600).
# Remote/off-site is RECOMMENDED but not fail-closed for dogfood.
# Do not claim production RPO/RTO from dogfood backups.

NEXA_ENV=dogfood
BACKUP_DIR=/var/backups/nexa
BACKUP_RETENTION_DAYS=30
BACKUP_LOCK_FILE=/var/lock/nexa-db-backup.lock

IDENTITY_DATABASE_URL=postgresql://nexa_identity:CHANGE_ME@127.0.0.1:5433/nexa_identity
STAYS_DATABASE_URL=postgresql://nexa_stays:CHANGE_ME@127.0.0.1:5434/nexa_stays

BACKUP_REQUIRE_REMOTE=false
BACKUP_REMOTE_ENABLED=true
BACKUP_REMOTE_PROVIDER=filesystem
BACKUP_REMOTE_PATH=/opt/nexa/backups/offhost
