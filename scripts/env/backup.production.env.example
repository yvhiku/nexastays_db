# Production template only. Use configure-production-backup.sh interactively.
# Never commit real values. /etc/nexa/backup.env must be root:root 0600.
NEXA_ENV=production
BACKUP_DIR=/var/backups/nexa
BACKUP_RETENTION_DAYS=30
BACKUP_LOCK_FILE=/var/lock/nexa-db-backup.lock
IDENTITY_DATABASE_URL=postgresql://nexa_identity:CHANGE_ME@127.0.0.1:5433/nexa_identity
STAYS_DATABASE_URL=postgresql://nexa_stays:CHANGE_ME@127.0.0.1:5434/nexa_stays
BACKUP_REQUIRE_REMOTE=true
BACKUP_REMOTE_ENABLED=true
BACKUP_REMOTE_PROVIDER=r2
BACKUP_REMOTE_PATH=production
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=CHANGE_ME
R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
R2_REGION=auto
R2_LIFECYCLE_DAYS=30
R2_LIFECYCLE_VERIFIED=false
AGE_RECIPIENT=age1CHANGE_ME
AGE_PRIVATE_KEY_OFFSERVER_CONFIRMED=false
ALERT_SMTP_URL=smtps://CHANGE_ME:465
ALERT_SMTP_USERNAME=CHANGE_ME
ALERT_SMTP_PASSWORD=CHANGE_ME
ALERT_EMAIL_FROM=CHANGE_ME
ALERT_EMAIL_TO=CHANGE_ME
ALERT_WEBHOOK_URL=https://CHANGE_ME
