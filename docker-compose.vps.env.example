# VPS / dogfood data plane — passwords MUST be supplied via environment or env file.
# Local development may still use docker-compose.yml defaults (*_dev).
#
# Usage on VPS:
#   cp docker-compose.vps.env.example .env.db && chmod 600 .env.db
#   # edit strong passwords
#   bash scripts/ensure-vps-volumes.sh
#   docker compose --env-file .env.db -f docker-compose.yml up -d
#
# fail-closed: scripts/assert-vps-db-env.sh rejects *_dev / CHANGE_ME.

IDENTITY_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
STAYS_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
